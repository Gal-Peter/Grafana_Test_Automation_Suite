# Secrets and per-machine overrides. Everything else lives in config.json (env vars win over config.json).
# ---- AI (optional, OFF by default). Pick ONE free option, or leave as none ----
AI_PROVIDER=none                 # none | ollama (local, free) | custom (any OpenAI-compatible URL) | anthropic (PAID)
# AI_MODEL=llama3.1:8b           # ollama default; required for custom
# AI_BASE_URL=                   # required for custom, e.g. http://host:port/v1
# AI_API_KEY=                    # optional, for custom
# AI_MAX_CALLS=10                # hard cap on AI calls per process
# ANTHROPIC_API_KEY=             # only used if AI_PROVIDER=anthropic (this one bills you)
# BASE_URL=http://localhost:3000
# GF_USER=admin
# GF_PASSWORD=admin
# TRACE=retain-on-failure     # off | on | retain-on-failure
# VIDEO=retain-on-failure
# AI_FAILURE_ANALYSIS=true
# MOBILE_DEVICE=Android Emulator
# MOBILE_UDID=emulator-5554          # only needed when several devices are connected
